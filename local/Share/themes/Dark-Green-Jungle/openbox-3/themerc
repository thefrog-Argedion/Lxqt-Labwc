# @TODO: finish replacing the colors here


# Menu
menu.border.color: #eff0eb

menu.title.bg: Solid Flat
menu.title.bg.color: #162300
menu.title.bg.shadow: 0
menu.title.text.color: #e0e7ea
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #162300
menu.items.text.color: #e0e7ea
menu.items.disabled.text.color: #adb6af

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #568203
menu.items.active.text.color: #e0e7ea

menu.separator.color: #adb6af
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #162300

# Active window
window.active.border.color: #568203


window.active.title.bg: flat solid
window.active.title.bg.color: #162300
window.active.title.separator.color: #162300
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #e0e7ea

window.active.handle.bg: flat solid
window.active.handle.bg.color: #162300

window.active.grip.bg: flat solid
window.active.grip.bg.color: #162300

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #162300
window.active.button.unpressed.image.color: #e0e7ea

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #568203
window.active.button.pressed.image.color: #ffffff

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #162300
window.active.button.disabled.image.color: #adb6af

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #162300
window.active.button.hover.image.color: #568203

#window.active.button.toggled.bg: #568203
#window.active.button.toggled.image.color: #ffffff

# Inactive window
window.inactive.border.color: #223401

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #162300
window.inactive.title.separator.color: #162300
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #adb6af

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #162300

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #162300

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #162300
window.inactive.button.unpressed.image.color: #adb6af

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #568203
window.inactive.button.pressed.image.color: #ffffff

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #adb6af
window.inactive.button.disabled.image.color: #162300

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #162300
window.inactive.button.hover.image.color: #568203


# OSD
osd.border.width: 1
osd.border.color: #568203

osd.bg: flat solid
osd.bg.color: #162300
osd.label.bg: flat solid
osd.label.bg.color: #162300
osd.label.text.color: #e0e7ea

# OSD
osd.bg: Solid Flat
osd.bg.color: #162300
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #568203
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #162400

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #162300
#osd.button.unpressed.*.border.color: #e2e4e5

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #568203
#osd.button.pressed.*.border.color: #ffffff

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #eff0eb
#osd.button.focused.*.border.color: #162400

osd.button.focused.box.color: #568203


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
