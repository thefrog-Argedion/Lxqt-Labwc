]]

conky.config = {

-------------------------------------
--  Generic Settings
-------------------------------------
	background = true,
	update_interval = 1,
	double_buffer = true,
	imlib_cache_size=10,
	draw_shades=false,
	default_shade_color = '#000000',
	draw_outline=false,
	draw_borders=false,
	total_run_times = 0,
	use_xft = true,
	no_buffers=true,
-------------------------------------
--  Window Specifications
-------------------------------------

alignment = 'top_right',
	gap_y = 5,
	minimum_width = 150,
	minimum_height = 90,
	own_window = true,
	own_window_class = "Conky",
	own_window_type = 'desktop',
	own_window_transparent = false,
	own_window_argb_visual = true,
	own_window_argb_value = 100,
	
-------------------------------------
--  Text Settings
-------------------------------------
	xftalpha=1,
	font="Tahoma:size=10",
	text_buffer_size=256,
	override_utf8_locale=true,
	draw_graph_borders = false,
	draw_outline = false,
	default_outline_color = '#828282',
	uppercase = false,
	
-------------------------------------
--  Color Scheme
-------------------------------------

	
default_color = '02FF00',
	color2 = 'ff0000', -- red
	color1 = '02FF00', --green
	color3 = 'e8ab49', -- orange
	color4= 'b58bf0', -- purple
	color5="ffffff",  --  white
	color6 = 'b13916',  --  red-autumn
	color7 = 'f0efef',   -- offwhite
-------------------------------------
--  End
-------------------------------------

}

conky.text = [[
${voffset 10}\
$alignc${font Tahoma :size=40}${color7}\
${time %I}:${time %M}${font}${color}

]]
