conky.config = {

-------------------------------------
--  Generic Settings
-------------------------------------
	background = true,
	update_interval = 1,
	double_buffer = true,
	imlib_cache_size=10,
	draw_shades=false,
	default_shade_color = '#000000',
	draw_outline=false,
	draw_borders=false,
	total_run_times = 0,
	use_xft = true,
	no_buffers=true,
-------------------------------------
--  Window Specifications
-------------------------------------

alignment = 'top_right',
	gap_y = 5,
	minimum_width = 300,
	minimum_height = 310,
	own_window = true,
	own_window_class = "Conky",
	own_window_type = 'desktop',
	own_window_transparent = false,
	own_window_argb_visual = true,
	own_window_argb_value = 225,
	
-------------------------------------
--  Text Settings
-------------------------------------
	xftalpha=1,
	font="Tahoma:size=10",
	text_buffer_size=256,
	override_utf8_locale=true,
	draw_graph_borders = false,
	draw_outline = false,
	default_outline_color = '#828282',
	uppercase = false,
	
-------------------------------------
--  Color Scheme
-------------------------------------

	default_color="ffffff",

	color0="b58bf0",  --  purple
	color1="45FF00",  --  green-2
	color2="ff0000",  --  red
	color3 = 'b8b8b8',  --  grey
	color4="ffffff",  --  white
-------------------------------------
--  End
-------------------------------------

}

conky.text = [[
${image /home/thefrog/.config/conky/images/myne/backgrounds/clock-roman-enos.png -s 300x310}\
\
\
\
${voffset 80}\
$alignc${font Tahoma :size=40}${color3}\
${time %I}:${time %M}${font}${color}
\
\
\
\
$alignc${font Tahoma :size=18}${color0} ${voffset 10}${execi 300 LANG=${template9} LC_TIME=${template9} date +"%A "}
$alignc${execi 300 LANG=${template9} LC_TIME=${template9} date +" %B "}
$alignc${color3}${execi 300 LANG=${template9} LC_TIME=${template9} date +" %d"}${font}
]]
