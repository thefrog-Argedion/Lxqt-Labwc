conky.config = {



--Text alignment, other possible values are commented
alignment = 'bottom_left',

maximum_width = 350,


-- COLORS
default_color = '02FF00',
	color4 = 'ff0000', -- red
	color1 = '02FF00', --green
	color3 = 'e8ab49', -- orange
	color2 = 'b58bf0', -- purple
	color5 = '#0f0ef0',  --  blue
	color6 = 'b13916',  --  red-autumn
	color7 = 'f0efef',   -- offwhite
	color8 = '8e8e95',   -- grayish
	color9 = '000000',  -- black
	-- 'D70751', -- Debian Red
	-- 'FFA54F', -- Tan 1
	-- 'FFA500', -- Orange
	-- 'b58bf0', -- purple

-- set to = true if you want Conky to be forked in the background
background = true, -- set to false when editing for errors
own_window_class = "Conky",
own_window = true,
own_window_type = 'normal',
own_window_transparent = false,
own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
own_window_argb_visual = true,
own_window_argb_value = 150,
out_to_console = false,
use_xft = true,

font = 'Hack:size=10:antialias=true',
update_interval = 1,

--This is the number of times Conky will update before quitting
--Set to zero to run forever.
--total_run_times 0

--Create own window instead of using desktop (required in nautilus)
own_window = true,

--Use double buffering (reduces flicker, may not work for everyone)
double_buffer = true,

draw_shades = false,

--Draw outlines?
draw_outline = false,

--Draw borders around text
draw_borders = false,

--Stippled borders?
stippled_borders = 1,

--border width
--border_width = 10,

--Default colors and also border colors
default_color = 'lightgrey',
default_shade_color = 'white',
default_outline_color = 'white',


--Gap between borders of screen and text
gap_x = 10,
gap_y = 10,

--Add spaces to keep things from moving about?  This only affects certain objects.
use_spacer = 'left',

--Subtract file system buffers from used memory?
no_buffers = true,
--no_buffers = false,

--set to = true if you want all text to be in uppercase
uppercase = false,

default_bar_width = 140,
default_bar_height = 6
}

conky.text = [[
${image /home/thefrog/.config/conky/images/myne/backgrounds/net.png -s 370x230}
${color4}BCST:${color7}${texeci 60 curl -s https://icanhazip.com}$color ${alignr}${color7}${wireless_mode wlan0} ${color4}BASE
${color4}WiFi:${color7}${addr wlan0}$color ${alignr}${color4}SIG:${color7}${wireless_link_qual_perc wlan0} %$color
${color5}${upspeedgraph wlan0 20, 175 000000 FFA500}$color ${color5}$alignr${downspeedgraph wlan0 20, 175 000000 FFA500}$color
${color4}UP:${color7}  ${upspeed wlan0}/s$color      ${alignr}${color7}${downspeed wlan0}/s$color :${color4}DN
${if_match "${addr eno1}"!="No Address"}
${color4}ETH0:${color7}${addr eno1} ${alignr}${color4}SPD:$color7${downspeedf eno1}kB/s
${color5}${upspeedgraph eno1 20, 175 000000 FFA500}$color ${color5}$alignr${downspeedgraph eno1 20, 175 000000 FFA500}$color
${color4}UP:${color7}  ${upspeed eno1}/s$color      ${alignr}${color7}${downspeed eno1}/s$color :${color4}DN${else}${endif}
]]
