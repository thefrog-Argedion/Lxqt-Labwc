// Inspired by Coffee and Kush
{ "$schema":
    "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "width": 40,
        "source":  "/home/thefrog/.config/fastfetch/Logos/EndeavourOS_Astronaut_Heart.png",
        "padding": {
            "top": 4,
            "left": 2,
            "right": 2
        }
     },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "{#33}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#33}󰊠                                     OS                                          󰊠",
            "type": "custom"
        },
        {
            "key": "{#33}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#33}    Distro   ",
            "type": "os"
        },
        {
            "key": "{#33}    DE       ",
            "type": "de"
        },
        {
            "key": "{#33}    WM       ",
            "type": "wm"
        },
        {
            "key": "{#33}  󰍂  LM       ",
            "type": "lm"
        },
        {
            "key": "{#33}    Kernel   ",
            "type": "kernel"
        },
        {
            "key": "{#33}  󱐋  BootMgr  ",
            "type": "bootmgr"
        },
        {
            "key": "{#33}  󰏖  Packages ",
            "type": "packages"
        },
        {
            "type": "command",
            "key": "{#33}  󰥔  OS Age   ",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "key": "{#33}  󰥔  Uptime   ",
            "type": "uptime"
        },
        {
            "key": "{#34}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#34}󰊠                                 Hardware                                        󰊠",
            "type": "custom"
        },
        {
            "key": "{#34}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#34}  󰇅  Machine  ",
            "type": "host",
        },
        {
            "key": "{#34}    Board    ",
            "type": "board"
        },
        {
            "key": "{#34}    Bios     ",
            "type": "bios"
        },
        {
            "key": "{#34}  󰍛  CPU      ",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "{#34}  󰍛  GFX      ",
            "type": "gpu",
        },
        {
            "key": "{#34}  󰍛  Vulkan   ",
            "type": "vulkan",
        },
        {
            "key": "{#34}  󰍹  Monitor  ",
            "type": "monitor"
        },
        {
            "key": "{#35}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#35}󰊠                             Needfull Things                                     󰊠",
            "type": "custom"
        },
        {
            "key": "{#35}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#35}    Terminal ",
            "type": "terminal"
        },
        {
            "key": "{#35}    TermFont ",
            "type": "terminalfont"    
        },
        {
            "key": "{#35}    Shell    ",
            "type": "shell"
        },
        {
            "type": "custom",
            "format": "\u001b[37m    󰮯 {#35}     {#34}    {#33}      {#32}     {#31}     {#34}     {#35}      {#37}󰊠\u001b[0m"
        },
        {
            "key": "{#32}  󰤢  WiFi     ",
            "type": "wifi",
        },
        {
            "key": "{#32}  󰖠  Camera   ",
            "type": "camera",
        },
        {
            "key": "{#32}  󰜟  Sound    ",
            "type": "sound",
        },
        {
            "key": "{#32}  Media    ",
            "type": "media",
        },
        {
            "key": "{#31}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#31}󰊠                                Graphs                                           󰊠",
            "type": "custom"
        },
        {
            "key": "{#31}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "type": "disk",
            "keyColor": "red",
            "key": "    Disk    ",
            "percent": {
        "type": 3,           // 3 = show number + bar + percentage
        "green": 30,         // Below 30% usage is green
        "yellow": 70         // 30-70% is yellow, >70% is red
      },
      "bar": {
        "width": 20,         // Number of characters for the bar
        "charElapsed": "■",  // Used bar character
        "charTotal": "-",    // Unused bar character
        "borderLeft": "[",
        "borderRight": "]"
      }
        },
        {
            "type": "custom",
            "format": "\u001b[37m    󰮯 {#35}     {#34}    {#33}      {#32}     {#31}     {#34}     {#35}      {#37}󰊠\u001b[0m"
        },
         {
            "type": "memory",
            "key": "    Memory  ",
            "keyColor": "31",
            "percent": {
        "type": 3, // 3 = show number + bar + percentage
        "green": 30, // <30% is green
        "yellow": 70 // 30-70% is yellow, >70% is red
      },
      "bar": {
        "width": 20, // number of characters in the bar
        "charElapsed": "■", // used part of the bar
        "charTotal": "-", // unused part of the bar
        "borderLeft": "[",
        "borderRight": "]"
      }
        },
        {
            "type": "swap",
            "key": "  󰯍  Swap    ",
            "keyColor": "31",
             "percent": {
        "type": 3,
        "green": 30,
        "yellow": 70
      },
      "bar": {
        "width": 20,
        "charElapsed": "■",
        "charTotal": "-",
        "borderLeft": "[",
        "borderRight": "]"
      }
        },
        "break",
        {
            "key": "{#35}    Palette",
            "type": "terminal",
            "format": "{#37}󰮯 {#36}   󰊠 {#35} 󰊠 {#34} 󰊠 {#33} 󰊠 {#32} 󰊠 {#31} 󰊠 {#38;5;234} 󰊠 "
        },

    ]
}
