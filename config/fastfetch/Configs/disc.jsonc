// current prompt (prompt.jsonc) 
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "left": 1,
            "right": 2
        }
    },
    "modules": [
        "break",
         {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────── Quick Look ────────────────────────┐"
        },
        {
            "type": "os",
            "key": "│  OS    ",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "│  KERNEL",
            "keyColor": "magenta"
        },
         {
            "type": "memory",
            "key": "│ 󰍛 MEMORY",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────────────── Connected Drives ───────────────────────┐"
        },
        {
            "type": "disk",
            "key": "│  DISK",
            "keyColor": "red"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────────────┘"
        },
        "break",
    ]
}
