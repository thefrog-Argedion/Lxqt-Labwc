// Inspired by Coffee and Kush
// Grabbed from Endeavour (Noodly) 
// Stripped for prompt. 
{ "$schema":
    "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "left": 1,
            "right": 2
        }
     },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭─────────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#36}  Distro   {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#35}  DE       {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#33}  WM       {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#33}  Kernel   {#keys}│",
            "type": "kernel"
        },
        {
            "key": "├─────────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#33}󰇅  Machine  {#keys}│",
            "type": "host",
        },
        {
            "key": "│ {#33}󰍛  CPU      {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#33}󰍛  GFX      {#keys}│",
            "type": "gpu",
        },
        {
            "key": "│ {#33}󰍛  Vulkan   {#keys}│",
            "type": "vulkan",
        },
        {
            "key": "│ {#33}󰟶  Memory   {#keys}│",
            "type": "memory"
        },
        {
            "key": "├─────────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#33}󰤢  WiFi     {#keys}│",
            "type": "wifi",
        },
        {
            "key": "│ {#33}󰖠  Camera   {#keys}│",
            "type": "camera",
        },
        {
            "key": "│ {#33}󰜟  Sound    {#keys}│",
            "type": "sound",
        },
        {
            "key": "├─────────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#33}  Palette  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰─────────────╯",
            "type": "custom"
        }
    ]
}
