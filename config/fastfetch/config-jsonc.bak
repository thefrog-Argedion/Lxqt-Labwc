// Inspired by Coffee and Kush
{ "$schema":
    "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "width": 40,
        "source":  "/home/thefrog/Pictures/Logos/Endeavour/eos-lxqt-purple.png",
        "padding": {
            "top": 10,
            "left": 2,
            "right": 2
        }
     },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "{#33}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#33}󰊠                                OS                               󰊠",
            "type": "custom"
        },
        {
            "key": "{#33}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#37}    Distro   ",
            "type": "os"
        },
        {
            "key": "{#37}    DE       ",
            "type": "de"
        },
        {
            "key": "{#37}  󰔃  WM       ",
            "type": "wm"
        },
        {
            "key": "{#37}  󰍂  LM       ",
            "type": "lm"
        },
        {
            "key": "{#37}    Kernel   ",
            "type": "kernel"
        },
        {
            "key": "{#37}  󱐋  BootMgr  ",
            "type": "bootmgr"
        },
        {
            "key": "{#37}  󰏖  Packages ",
            "type": "packages"
        },
        {
            "type": "command",
            "key": "{#37}  󰥔  OS Age   ",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "key": "{#37}  󰥔  Uptime   ",
            "type": "uptime"
        },
        {
            "key": "{#34}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#34}󰊠                             Hardware                            󰊠",
            "type": "custom"
        },
        {
            "key": "{#34}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#37}  󰇅  Machine  ",
            "type": "host",
        },
        {
            "key": "{#37}    Board    ",
            "type": "board"
        },
        {
            "key": "{#37}    Bios     ",
            "type": "bios"
        },
        {
            "key": "{#37}  󰍛  CPU      ",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "{#37}  󰍛  GFX      ",
            "type": "gpu",
            "format": "{1}"
        },
        {
            "key": "{#37}  󰍛  Vulkan   ",
            "type": "vulkan",
        },
        {
            "key": "{#37}  󰍹  Monitor  ",
            "type": "monitor",
            "format": "{2}x{3}"
        },
        {
            "key": "{#35}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#35}󰊠                         Needfull Things                         󰊠",
            "type": "custom"
        },
        {
            "key": "{#35}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#37}    Terminal ",
            "type": "terminal"
        },
        {
            "key": "{#37}    TermFont ",
            "type": "terminalfont"    
        },
        {
            "key": "{#37}    Shell    ",
            "type": "shell"
        },
        {
            "key": "{#37}  󰤢  WiFi     ",
            "type": "wifi",
        },
        {
            "key": "{#37}  󰖠  Camera   ",
            "type": "camera",
        },
        {
            "key": "{#37}  󰜟  Sound    ",
            "type": "sound",
            "format": "{name:38} ({3})"
        },
        {
            "key": "{#37}  Media    ",
            "type": "media",
        },
        {
            "key": "{#31}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "key": "{#31}󰊠                             Graphs                              󰊠",
            "type": "custom"
        },
        {
            "key": "{#31}󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠 󰊠",
            "type": "custom"
        },
        {
            "type": "disk",
            "key": "{#37}    Disk    ",
            "percent": {
        "type": 3,           // 3 = show number + bar + percentage
        "green": 30,         // Below 30% usage is green
        "yellow": 70         // 30-70% is yellow, >70% is red
      },
      "bar": {
        "width": 20,         // Number of characters for the bar
        "charElapsed": "■",  // Used bar character
        "charTotal": "-",    // Unused bar character
        "borderLeft": "[",
        "borderRight": "]"
      }
        },
         {
            "type": "memory",
            "key": "{#37}    Memory  ",
            "percent": {
        "type": 3, // 3 = show number + bar + percentage
        "green": 30, // <30% is green
        "yellow": 70 // 30-70% is yellow, >70% is red
      },
      "bar": {
        "width": 20, // number of characters in the bar
        "charElapsed": "■", // used part of the bar
        "charTotal": "-", // unused part of the bar
        "borderLeft": "[",
        "borderRight": "]"
      }
        },
        {
            "type": "swap",
            "key": "{#37}  󰯍  Swap    ",
             "percent": {
        "type": 3,
        "green": 30,
        "yellow": 70
      },
      "bar": {
        "width": 20,
        "charElapsed": "■",
        "charTotal": "-",
        "borderLeft": "[",
        "borderRight": "]"
      }
        },
        "break",
        {
            "key": "{#37}    Palette",
            "type": "terminal",
            "format": "      {#37}󰮯 {#36}   󰊠 {#35} 󰊠 {#34} 󰊠 {#33} 󰊠 {#32} 󰊠 {#31} 󰊠 {#38;5;234} 󰊠 "
        },

    ]
}
